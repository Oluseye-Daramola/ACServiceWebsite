# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
# Local:  mongodb://127.0.0.1:27017/ac-website
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ac-website
MONGO_URI=mongodb://127.0.0.1:27017/ac-website
# Use a long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Avoid 6000: browsers block it
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
# Public URL of this API (used in shared invoice PDF links and local upload URLs)
API_URL=http://localhost:5000

# --- First admin (used by: npm run seed) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=

# --- Company details printed on invoices ---
COMPANY_NAME=AC Services Ltd
COMPANY_EMAIL=info@example.com
COMPANY_PHONE=+234 800 000 0000
COMPANY_ADDRESS=Lagos, Nigeria
CURRENCY=NGN
# Time zone for dates/times on invoice and report PDFs
TIMEZONE=Africa/Lagos
# Used to convert local numbers like 0803... to international format for WhatsApp
DEFAULT_COUNTRY_CODE=234

# --- Email (optional; needed for sending invoices by email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Who gets an email when a website enquiry comes in (comma separated).
# Leave empty to notify every active admin account.
ENQUIRY_NOTIFY_EMAILS=

# --- Cloudinary (optional; files are saved to ./uploads when not set) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

{
  "info": {
    "name": "AC Website API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom for the full flow. Logins store tokens; created ids are stored in collection variables."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "techToken",
      "value": ""
    },
    {
      "key": "enquiryId",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "technicianId",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.token) pm.collectionVariables.set(\"adminToken\", j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"08000000000\"\n}"
            }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"ChangeMe123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "description": "Emails a reset link (valid 30 min) to {CLIENT_URL}/reset-password?token=... Always returns the same message. Needs SMTP; in development without SMTP the link is printed in the server console."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<64-char token from the reset link>\",\n  \"password\": \"NewPass123!\"\n}"
            },
            "description": "Sets the new password, logs out all other devices and returns a fresh token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.token) pm.collectionVariables.set(\"adminToken\", j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Technicians (admin)",
      "item": [
        {
          "name": "Create technician",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/technicians",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tunde Tech\",\n  \"email\": \"tunde@example.com\",\n  \"phone\": \"08051112222\",\n  \"password\": \"TechPass123\",\n  \"specialization\": \"Split units\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.technician && j.technician._id) pm.collectionVariables.set(\"technicianId\", j.technician._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List technicians",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/technicians?isActive=true"
          }
        },
        {
          "name": "Get technician",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/technicians/{{technicianId}}"
          }
        },
        {
          "name": "Update technician",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/technicians/{{technicianId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specialization\": \"Split & cassette units\"\n}"
            }
          }
        },
        {
          "name": "Reset technician password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/technicians/{{technicianId}}/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"TechPass123\"\n}"
            }
          }
        },
        {
          "name": "Deactivate technician",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/technicians/{{technicianId}}"
          }
        }
      ]
    },
    {
      "name": "3. Enquiries",
      "item": [
        {
          "name": "Submit enquiry (public contact form)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/enquiries",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Obi\",\n  \"email\": \"ada@example.com\",\n  \"phone\": \"08031234567\",\n  \"address\": \"12 Allen Ave, Ikeja\",\n  \"serviceType\": \"repair\",\n  \"message\": \"My split AC is leaking water\",\n  \"preferredDate\": \"2026-10-25\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.enquiryId) pm.collectionVariables.set(\"enquiryId\", j.enquiryId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List enquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/enquiries?status=new&page=1&limit=20"
          }
        },
        {
          "name": "Get enquiry",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}"
          }
        },
        {
          "name": "Update enquiry status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"contacted\",\n  \"adminNotes\": \"Called client\"\n}"
            }
          }
        },
        {
          "name": "Convert enquiry to service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}/convert",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": \"{{technicianId}}\",\n  \"scheduledDate\": \"2026-10-25\",\n  \"priority\": \"high\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.service && j.service._id) pm.collectionVariables.set(\"serviceId\", j.service._id);",
                  "if (j && j.client && j.client._id) pm.collectionVariables.set(\"clientId\", j.client._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete enquiry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}"
          }
        }
      ]
    },

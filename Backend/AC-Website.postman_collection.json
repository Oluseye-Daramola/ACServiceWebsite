              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/reports/{{reportId}}/pdf",
            "description": "Admin or the report's technician (use {{techToken}}). Add ?inline=true to view in the browser. Unsigned reports are marked DRAFT."
          }
        },
        {
          "name": "Email signed report to client (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports/{{reportId}}/send-email",
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Sends the PDF to the client's email, or pass { \"email\": \"...\" } to override. Report must be signed by both parties."
          }
        }
      ]
    },
    {
      "name": "7. Invoices (admin)",
      "item": [
        {
          "name": "Create invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/invoices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"items\": [\n    {\n      \"description\": \"Repair labour\",\n      \"quantity\": 1,\n      \"unitPrice\": 20000\n    },\n    {\n      \"description\": \"Drain hose\",\n      \"quantity\": 2,\n      \"unitPrice\": 2500\n    }\n  ],\n  \"taxRate\": 7.5,\n  \"discount\": 1000,\n  \"dueDate\": \"2026-11-05\",\n  \"notes\": \"Pay to: AC Services Ltd, Bank XYZ, 0123456789\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.invoice && j.invoice._id) pm.collectionVariables.set(\"invoiceId\", j.invoice._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List invoices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/invoices?status=unpaid"
          }
        },
        {
          "name": "Get invoice (with payments)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/invoices/{{invoiceId}}"
          }
        },
        {
          "name": "Update invoice (before any payment)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/invoices/{{invoiceId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discount\": 1000\n}"
            }
          }
        },
        {
          "name": "Download PDF (use Send and Download)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/invoices/{{invoiceId}}/pdf"
          }
        },
        {
          "name": "Send invoice by email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/invoices/{{invoiceId}}/send-email",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Share invoice to WhatsApp (returns wa.me link)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/invoices/{{invoiceId}}/share-whatsapp",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Cancel invoice",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/invoices/{{invoiceId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "8. Transactions (admin)",
      "item": [
        {
          "name": "Record payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": \"{{invoiceId}}\",\n  \"amount\": 10000,\n  \"method\": \"bank_transfer\",\n  \"paymentRef\": \"TRF-12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.transaction && j.transaction._id) pm.collectionVariables.set(\"transactionId\", j.transaction._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Record final payment (invoice -> paid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": \"{{invoiceId}}\",\n  \"amount\": 15800,\n  \"method\": \"cash\"\n}"
            }
          }
        },
        {
          "name": "Transaction history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/transactions?from=2026-01-01&to=2026-12-31"
          }
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/summary"
          }
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
          }
        },
        {
          "name": "Reverse transaction",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}/reverse",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Recorded in error\"\n}"
            }
          }
        }
      ]
    },

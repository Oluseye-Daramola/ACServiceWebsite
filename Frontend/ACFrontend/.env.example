# Copy to .env and adjust. Restart `npm run dev` after changes.
# Backend API base URL (must include /api). The backend's CLIENT_URL must allow this frontend's origin.
VITE_API_URL=http://localhost:5000/api
# Shown in the header/footer
VITE_COMPANY_NAME=Haycon Solutions Limited
# Should match the backend CURRENCY
VITE_CURRENCY=NGN
# Company details shown on the public website (same values as the backend's COMPANY_*)
VITE_COMPANY_EMAIL=haycontech.solutions500@gmail.com
VITE_COMPANY_PHONE=+234 702 524 2589
VITE_COMPANY_ADDRESS=Lagos, Nigeria
VITE_COMPANY_HOURS=Mon – Sat, 8:00am – 6:00pm
